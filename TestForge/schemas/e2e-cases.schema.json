{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestForge E2E Cases",
  "type": "object",
  "required": ["e2e_cases"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "generated_at": { "type": "string" },
        "base_url": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "e2e_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "ac_ids", "source_refs", "feature", "priority", "preconditions", "steps", "expected_result", "test_data"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "ac_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "feature": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "persona": { "type": "string" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action", "expected"],
              "properties": {
                "action": { "type": "string" },
                "locator_hint": { "type": "string" },
                "data": { "type": "string" },
                "expected": { "type": "string" }
              }
            }
          },
          "expected_result": { "type": "string" },
          "test_data": { "type": "object" },
          "api_setup": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": { "type": "string" },
                "path": { "type": "string" },
                "body": { "type": "object" },
                "expected_status": { "type": "integer" }
              }
            }
          },
          "cleanup": { "type": "array", "items": { "type": "string" } },
          "automatable": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "journey_id": { "type": "string" },
          "name": { "type": "string" },
          "persona": { "type": "string" },
          "case_ids": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "gap_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gap_id": { "type": "string" },
          "description": { "type": "string" },
          "impact": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
