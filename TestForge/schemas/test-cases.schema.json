{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestForge Test Cases",
  "type": "object",
  "required": ["test_cases"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "generated_at": { "type": "string" },
        "source_context": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "ac_ids", "source_refs", "technique", "priority", "type", "preconditions", "steps", "expected_result", "automatable"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 4 },
          "ac_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "ti_ids": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "technique": {
            "type": "string",
            "enum": ["EP", "BVA", "DT", "ST", "scenario", "error-guessing", "permission", "idempotency", "concurrency", "contract", "property", "pairwise"]
          },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "type": {
            "type": "string",
            "enum": ["functional", "negative", "boundary", "permission", "state", "integration", "contract", "nonfunctional", "e2e", "regression"]
          },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action", "expected"],
              "properties": {
                "action": { "type": "string", "minLength": 2 },
                "data": { "type": "string" },
                "expected": { "type": "string", "minLength": 1 }
              }
            }
          },
          "test_data": { "type": "object" },
          "expected_result": { "type": "string", "minLength": 4 },
          "postconditions": { "type": "array", "items": { "type": "string" } },
          "automatable": { "type": "boolean" },
          "automation": {
            "type": "object",
            "properties": {
              "framework": { "type": "string" },
              "file": { "type": "string" },
              "notes": { "type": "string" }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "coverage_matrix": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "gap_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "description", "impact", "owner"],
        "properties": {
          "gap_id": { "type": "string" },
          "description": { "type": "string" },
          "impact": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    },
    "self_check": {
      "type": "object",
      "properties": {
        "missing": { "type": "array", "items": { "type": "string" } },
        "duplicates": { "type": "array", "items": { "type": "string" } },
        "unexecutable": { "type": "array", "items": { "type": "string" } },
        "unsupported_expectations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
