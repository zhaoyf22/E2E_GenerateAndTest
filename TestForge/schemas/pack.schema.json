{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestForge Pack",
  "type": "object",
  "required": ["id", "commands"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "display_name": { "type": "string" },
    "version": { "type": "string" },
    "detect": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "globs": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "integer", "default": 10 }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command"],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "required": { "type": "boolean", "default": false },
          "install": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "parser": {
          "type": "string",
          "enum": ["coverage.py", "jacoco", "lcov", "cobertura", "istanbul", "gcovr", "none"]
        },
        "report": { "type": "string" }
      },
      "additionalProperties": true
    },
    "mutation": {
      "type": "object",
      "properties": {
        "tool": { "type": "string" },
        "parser": {
          "type": "string",
          "enum": ["json", "pit-xml", "stryker-json", "mutmut", "none"]
        },
        "report": { "type": "string" },
        "score_key": { "type": "string" }
      },
      "additionalProperties": true
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "target": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "scaffold": {
      "type": "object",
      "properties": {
        "default_template": { "type": "string" },
        "by_type": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "prompt_partials": { "type": "array", "items": { "type": "string" } },
    "adapters": { "type": "array", "items": { "type": "string" } },
    "ci": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "string" },
    "requires": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
