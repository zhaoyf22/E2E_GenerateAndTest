{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestForge Testable Items",
  "type": "object",
  "required": ["meta", "requirements", "testable_items", "gap_list"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["project", "generated_at"],
      "properties": {
        "project": { "type": "string" },
        "generated_at": { "type": "string" },
        "source_files": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ac_id", "text", "source_refs"],
        "properties": {
          "ac_id": { "type": "string" },
          "text": { "type": "string" },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "notes": { "type": "string" }
        }
      }
    },
    "testable_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ti_id", "ac_ids", "description", "techniques", "source_refs"],
        "properties": {
          "ti_id": { "type": "string" },
          "ac_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "description": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["functional", "negative", "boundary", "permission", "state", "integration", "contract", "nonfunctional", "e2e"]
          },
          "techniques": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["EP", "BVA", "DT", "ST", "scenario", "error-guessing", "permission", "idempotency", "concurrency", "contract", "property", "pairwise"]
            }
          },
          "input_domain": {
            "type": "object",
            "properties": {
              "fields": { "type": "array", "items": { "type": "string" } },
              "constraints": { "type": "array", "items": { "type": "string" } },
              "states": { "type": "array", "items": { "type": "string" } }
            }
          },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "risk": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "gap_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "description", "impact", "owner"],
        "properties": {
          "gap_id": { "type": "string" },
          "description": { "type": "string" },
          "impact": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
